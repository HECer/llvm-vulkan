#version 450
layout(local_size_x = 128) in;
layout(set = 0, binding = 0, std430) readonly buffer Off { uint offsets[]; };
layout(set = 0, binding = 1, std430) readonly buffer Edge { uint edges[]; };
layout(set = 0, binding = 2, std430) readonly buffer Before { uint before[]; };
layout(set = 0, binding = 3, std430) writeonly buffer After { uint after[]; };
layout(set = 0, binding = 4, std430) buffer Changed { uint changed; };
layout(push_constant) uniform Params {
  uint n;
  uint a;
  uint b;
  uint c;
  uint d;
  uint e;
  uint base;
  uint pad;
}
p;
void main() {
  uint v = p.base + gl_GlobalInvocationID.x;
  if (v >= p.n)
    return;
  uint r = before[v];
  for (uint j = offsets[v]; j < offsets[v + 1u] && r == 0u; ++j)
    r |= before[edges[j]];
  after[v] = r;
  if (r != before[v])
    atomicOr(changed, 1u);
}
